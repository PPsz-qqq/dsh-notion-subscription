# Placeholder only. This plugin does NOT auto-load .env files.
# Set these in the DSH host launch environment; never commit real values.
#
# Only NOTION_COOKIE is required. When it is set, spaceId/userId are
# discovered from Notion on the first call (autoDiscover defaults to on).
NOTION_COOKIE=<your-own-token-v2-or-cookie>
# Optional overrides; leave empty to auto-discover.
NOTION_SPACE_ID=
NOTION_USER_ID=
# Optional; the bundled build string is used when empty and will age.
NOTION_CLIENT_VERSION=<your-captured-client-version>
# Optional manual smoke test, consumes real allowance only when explicitly enabled.
NOTION_ALLOW_LIVE_TEST=0
# Optional override; defaults to the shipped catalog entry (claude-sonnet4.6).
NOTION_MODEL_ID=<your-captured-internal-model-id>
# stream-end (default) | final-record | verified-marker
NOTION_COMPLETION_MODE=stream-end
NOTION_TERMINAL_TYPE=<your-verified-success-frame-type>
NOTION_TERMINAL_PATH=
NOTION_TERMINAL_VALUE=